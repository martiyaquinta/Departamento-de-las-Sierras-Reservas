# Obligatorias (Vercel: Settings → Environment Variables → Edit, no Create)
# Tras cambiar NEXT_PUBLIC_*: Redeploy (Clear cache) en Production
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local: http://localhost:3000 · Prod Vercel: https://departamentodelassierras.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Export iCal para Booking/Airbnb (sync de ocupación). Mín. 16 chars.
# URL: {SITE_URL}/api/calendar/export.ics?token=...
ICAL_EXPORT_TOKEN=

# Import iCal desde Booking (Booking → web). Default hardcodeado si vacío.
BOOKING_ICAL_URL=https://ical.booking.com/v1/export?t=...

# Opcional: Vercel Cron Authorization Bearer (si no, usa ICAL_EXPORT_TOKEN)
# CRON_SECRET=

# Aliases opcionales (server-only) si NEXT_PUBLIC_* no llegan al runtime
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Mail al dueño cuando llega una reserva
RESEND_API_KEY=
RESEND_FROM_EMAIL=Departamento de las Sierras <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=centrodelassierras@gmail.com
# Contraseña del panel /admin (independiente de Supabase Auth UI)
ADMIN_PASSWORD=

# Web Push (admin). Generar: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o https:// — contacto del dueño de las keys
VAPID_SUBJECT=mailto:centrodelassierras@gmail.com
